import "./style.css";
import { Brand } from "#app/shared/templates/brand";
import { signout, StaffUser } from "#app/shared/services/auth";
import { initials } from "#app/shared/services/hiring";

<StaffLayout (user: StaffUser, active: string = "", full: boolean = false)>
  <div class="app staff-layout">
    <header class="staff-header">
      <div class={["page-shell staff-header-inner row", full ? "is-full" : "is-wide"]}>
        <div class="staff-left row">
          <Brand href="/hiring" tag="hiring" />
          <nav class="staff-nav row" aria-label="Hiring">
            <a href="/hiring" class={[active === "dashboard" && "is-active"]}>
              {user.role === "admin" ? "Dashboard" : "My candidates"}
            </a>
            <a class="is-external" href="/" target="_blank" rel="noopener">Careers page</a>
          </nav>
        </div>

        <div class="staff-user row">
          <span class="avatar is-sm" title={user.title}>{initials(user.name)}</span>
          <span class="staff-user-name">{user.name}</span>
          <span class={["pill", user.role === "admin" && "is-accent"]}>{user.role}</span>
          <button class="is-ghost is-sm" onclick={() => signout()}>Sign out</button>
        </div>
      </div>
    </header>

    <main class="app-main staff-main">
      <div class={["page-shell", full ? "is-full" : "is-wide"]}>
        <slot/>
      </div>
    </main>
  </div>
</StaffLayout>
