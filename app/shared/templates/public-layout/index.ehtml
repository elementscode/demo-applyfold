import "./style.css";
import { Brand } from "#app/shared/templates/brand";

<PublicLayout>
  <div class="app public-layout">
    <header class="public-header">
      <div class="page-shell public-header-inner row">
        <Brand tag="careers" />
        <a class="button is-ghost is-sm" href="/signin">Hiring team</a>
      </div>
    </header>

    <main class="app-main">
      <slot/>
    </main>

    <footer class="public-footer">
      <div class="page-shell public-footer-inner cluster">
        <span>applyfold · Hiring software for teams that care how it feels.</span>
        <a href="/">All open roles</a>
      </div>
    </footer>
  </div>
</PublicLayout>
