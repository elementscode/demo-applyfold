import "./style.css";
import { sendRejection } from "#app/shared/services/applications";

export interface RejectTarget {
  id: string;
  name: string;
  email: string;
}

/** The state a page holds to open the dialog: set `target` to open it. */
export interface RejectPrompt {
  target: RejectTarget | null;
  sending: boolean;
  error: string;
  sentAt: Date | null;
}

export function emptyRejectPrompt(): RejectPrompt {
  return { target: null, sending: false, error: "", sentAt: null };
}

function onSend(prompt: RejectPrompt) {
  if (!prompt.target) {
    return;
  }

  prompt.sending = true;

  try {
    prompt.sentAt = sendRejection(prompt.target.id);
    prompt.target = null;
    prompt.error = "";
  } catch (err: any) {
    prompt.error = err.message;
  } finally {
    prompt.sending = false;
  }
}

function onClose(prompt: RejectPrompt) {
  if (!prompt.sending) {
    prompt.target = null;
    prompt.error = "";
  }
}

<RejectDialog (prompt: RejectPrompt, jobTitle: string)>
  <div class="modal-backdrop" onclick={() => onClose(prompt)}>
    <div class="card modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="reject-title"
         onclick={(e) => e.stopPropagation()}>
      <div class="card-head">
        <h2 id="reject-title">Send a rejection email?</h2>
      </div>
      <div class="card-body stack">
        <p>
          {prompt.target!.name} is now in <strong>Rejected</strong>. Would you
          like to let them know with a short, polite note?
        </p>
        <p class="reject-preview">
          “Thank you for the time you put into applying for {jobTitle}… After
          careful consideration, we've decided not to move forward with your
          application for this role…”
        </p>
        <p class="hint">Sent to {prompt.target!.email} from the applyfold hiring team.</p>
        <p e:if={prompt.error} class="error" role="alert">{prompt.error}</p>
      </div>
      <div class="card-foot">
        <button class="is-ghost" onclick={() => onClose(prompt)} disabled={prompt.sending}>Not now</button>
        <button class="is-primary" oninsert={(e) => (e.target as HTMLButtonElement).focus()} onclick={() => onSend(prompt)} disabled={prompt.sending}>
          {prompt.sending ? "Sending…" : "Send email"}
        </button>
      </div>
    </div>
  </div>
</RejectDialog>
