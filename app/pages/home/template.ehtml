import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { PublicLayout } from "#app/shared/templates/public-layout";

export interface JobCard {
  id: string;
  title: string;
  team: string;
  location: string;
  summary: string;
}

interface TeamGroup {
  id: string;
  team: string;
  jobs: JobCard[];
}

export function groupByTeam(jobs: JobCard[]): TeamGroup[] {
  let groups: TeamGroup[] = [];

  for (let job of jobs) {
    let group = groups.find((g) => g.team === job.team);

    if (!group) {
      group = { id: job.team, team: job.team, jobs: [] };
      groups.push(group);
    }

    group.jobs.push(job);
  }

  return groups;
}

<html lang="en" class="page-home" (jobs: JobCard[])>
  <head>
    <title>Careers at applyfold</title>
    <meta name="description" content="Open roles at applyfold. We build hiring software for teams that care how it feels.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <PublicLayout>
      <div class="page-shell is-form">
        <div class="page-hero careers-hero">
          <p class="eyebrow">Careers at applyfold</p>
          <h1 class="display">Help teams hire like they mean it.</h1>
          <p class="lede">
            We're a small team building hiring software that treats candidates
            like people. Every application here is read by someone on the team
            you'd join.
          </p>
          <p class="careers-facts cluster is-md">
            <span>{jobs.length} open {jobs.length === 1 ? "role" : "roles"}</span>
            <span>Remote-friendly</span>
            <span>Series A, 24 people</span>
          </p>
        </div>

        <div class="careers-list stack is-xl">
          <section e:for={group of groupByTeam(jobs)} class="careers-team stack">
            <h2>{group.team}</h2>
            <JobItem e:for={job of group.jobs} {job} />
          </section>

          <p e:if={jobs.length === 0} class="careers-empty">
            No open roles right now. Check back soon.
          </p>
        </div>
      </div>
    </PublicLayout>
  </body>
</html>

<JobItem (job: JobCard)>
  <a class="card job-link" href={`/careers/${job.id}`}>
    <div class="card-body stack is-xs">
      <div class="job-arrow row">
        <h3>{job.title}</h3>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M7 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="job-meta">{job.team} · {job.location}</p>
      <p class="job-summary">{job.summary}</p>
    </div>
  </a>
</JobItem>
